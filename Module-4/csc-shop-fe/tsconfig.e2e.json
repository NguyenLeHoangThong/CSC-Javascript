{
  // E2E chạy trong Node (Playwright runner) NHƯNG code trong `page.evaluate()` chạy
  // trong trình duyệt — vì thế cần cả `types: ["node"]` lẫn lib DOM.
  // Tách riêng khỏi tsconfig.app.json để `src/` không vô tình dùng được API của Node.
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.e2e.tsbuildinfo",
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "types": ["node"],
    "skipLibCheck": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["e2e/**/*", "playwright.config.ts"]
}
