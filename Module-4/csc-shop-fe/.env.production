# Bài 38 — values used by `npm run build` (Vite picks the file by mode).
#
# ⚠️ EVERY VITE_* variable is compiled into the JS bundle and is readable by anyone
# who opens DevTools. Only public values belong here — a URL is fine, an API key is
# NOT. The Gemini key lives in the backend's environment (Bài 36).
#
# On Vercel, set the same variable in Project Settings -> Environment Variables so it
# can be changed without a commit; that value wins over this file.
VITE_API_URL=https://csc-shop-api.onrender.com/api/v1
