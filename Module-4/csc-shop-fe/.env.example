# Base URL of csc-shop-api. Copy this file to `.env` for local development.
#
# ⚠️ Bài 36 — Vite exposes EVERY `VITE_*` variable to the browser by compiling it into
# the bundle. A public URL is fine here. An API key, a JWT secret or a database
# password is NOT — those belong in the backend's environment only.
VITE_API_URL=http://localhost:3000/api/v1
