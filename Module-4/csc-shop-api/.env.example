# ── Database ─────────────────────────────────────────────────────────────
# PostgreSQL connection string — update user/password/host/db to match your machine.
# With docker-compose (Bài 40) the host is the service name `db`, not `localhost`.
DATABASE_URL="postgresql://postgres:password@localhost:5432/csc_shop_db"

NODE_ENV="development"
PORT=3000

# ── CORS (Bài 36) ────────────────────────────────────────────────────────
# Comma-separated whitelist of browser origins allowed to call this API.
# NEVER "*" in production. Add the Vercel URL here after Bài 38.
CORS_ORIGINS="http://localhost:5173"

# ── JWT ──────────────────────────────────────────────────────────────────
# MUST be long random strings in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="dev_access_secret_change_me"
JWT_REFRESH_SECRET="dev_refresh_secret_change_me"

# Token lifetimes
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# bcrypt cost factor (higher = slower = safer). 12 is a good balance.
BCRYPT_SALT_ROUNDS=12

# ── AI / Gemini (Bài 33 + Bài 35) ────────────────────────────────────────
# Get a key at https://aistudio.google.com/apikey
# This key is SERVER-ONLY. It must never appear in a VITE_* variable.
# Leave it empty and /api/v1/ai/suggest answers 503 — the rest of the API still works.
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.1-flash-lite"
