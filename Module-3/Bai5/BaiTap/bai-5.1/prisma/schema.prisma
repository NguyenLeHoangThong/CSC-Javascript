// Bài 5.1 — Course management. Practise relations, include, _count and unique constraints.
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Category {
  id      Int      @id @default(autoincrement())
  name    String   @db.VarChar(100)
  slug    String   @unique @db.VarChar(100)
  courses Course[]

  @@map("categories")
}

enum CourseStatus {
  draft
  published
  archived
}

model Course {
  id          Int          @id @default(autoincrement())
  title       String       @db.VarChar(200)
  description String?      @db.Text
  price       Decimal      @db.Decimal(15, 2)
  duration    Int // minutes
  categoryId  Int          @map("category_id")
  status      CourseStatus @default(draft)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")

  category    Category     @relation(fields: [categoryId], references: [id])
  enrollments Enrollment[]

  @@map("courses")
}

model Enrollment {
  id           Int      @id @default(autoincrement())
  studentName  String   @map("student_name") @db.VarChar(100)
  studentEmail String   @map("student_email") @db.VarChar(150)
  courseId     Int      @map("course_id")
  enrolledAt   DateTime @default(now()) @map("enrolled_at")

  course Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  // 1 email can't enroll the same course twice
  @@unique([studentEmail, courseId])
  @@map("enrollments")
}
