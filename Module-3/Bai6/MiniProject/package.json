  "devDependencies": {
    "@types/express": "^4.17.20",
    "@types/node": "^20.5.0",
    "@types/cors": "^2.8.14",
    "typescript": "^5.1.6",
    "ts-node": "^10.9.1",
    "ts-node-dev": "^2.0.0",
    "prisma": "^5.0.0"
