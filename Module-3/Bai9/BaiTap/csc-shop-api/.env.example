# PostgreSQL connection string — update user/password/host/db to match your machine
DATABASE_URL="postgresql://postgres:password@localhost:5432/csc_shop_db"
NODE_ENV="development"
PORT=3000

# JWT secrets — MUST be long random strings in production.
# Generate one with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="dev_access_secret_change_me"
JWT_REFRESH_SECRET="dev_refresh_secret_change_me"

# Token lifetimes
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# bcrypt cost factor (higher = slower = safer). 12 is a good balance.
BCRYPT_SALT_ROUNDS=12
