DATABASE_URL="postgresql://postgres:password@localhost:5432/school_db"
NODE_ENV="development"
PORT=3000

# JWT secrets — PHẢI là chuỗi ngẫu nhiên dài, khó đoán.
# Tạo bằng: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET="your_super_secret_access_key_change_this_in_production"
JWT_REFRESH_SECRET="your_super_secret_refresh_key_change_this_in_production"

# Thời hạn token
JWT_ACCESS_EXPIRES="15m"
JWT_REFRESH_EXPIRES="7d"

# Số vòng băm bcrypt (càng cao càng chậm, càng an toàn — 12 là cân bằng tốt)
BCRYPT_SALT_ROUNDS=12
